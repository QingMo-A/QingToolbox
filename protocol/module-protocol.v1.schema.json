{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingtoolbox.dev/schemas/module-protocol.v1.schema.json",
  "title": "QingToolbox module protocol v1 envelope",
  "type": "object",
  "required": ["protocolVersion", "messageType", "requestId", "payload"],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "messageType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "payload": {},
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "details": {}
      },
      "additionalProperties": false
    }
  }
}
