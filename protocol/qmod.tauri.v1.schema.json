{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingtoolbox.dev/schemas/qmod.tauri.v1.schema.json",
  "title": "QingToolbox Tauri qmod envelope v1",
  "type": "object",
  "required": ["schemaVersion", "moduleId", "version", "moduleApiVersion", "entryManifest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "moduleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
    },
    "moduleApiVersion": { "const": "tauri-process-v1" },
    "entryManifest": { "const": "module.json" }
  },
  "additionalProperties": false
}
