<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <QingToolboxHostRoot Condition="'$(QingToolboxHostRoot)' == ''">..\..\..\QingToolbox-toolbox</QingToolboxHostRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\modules\Launcher\QingToolbox.Modules.Launcher.csproj" AdditionalProperties="QingToolboxHostRoot=$(QingToolboxHostRoot)" />
    <ProjectReference Include="$(QingToolboxHostRoot)\QingToolbox.Core\QingToolbox.Core.csproj" />
  </ItemGroup>
</Project>
