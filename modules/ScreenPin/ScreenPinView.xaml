<UserControl x:Class="QingToolbox.Modules.ScreenPin.ScreenPinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360"
             MinHeight="300"
             Background="#F4F8FE"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#10264A"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>

        <Style x:Key="ScreenPinButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#23446F"/>
            <Setter Property="BorderBrush" Value="#D6E2F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EDF4FF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#AFC9F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DCEAFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6EA2F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.46"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScreenPinPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ScreenPinButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.46"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="22"
                    CornerRadius="18"
                    BorderBrush="#D9E7FA"
                    BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#EAF3FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="15" Background="#2563EB">
                        <Grid>
                            <Rectangle Width="27" Height="21" RadiusX="3" RadiusY="3"
                                       Stroke="White" StrokeThickness="2"/>
                            <Path Data="M 16,31 L 23,24 L 28,29 L 33,24 L 39,31"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Ellipse Width="4" Height="4" Margin="0,0,13,9"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="White"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,1,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Screen Pin"/>
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Capture a region and keep it floating on screen."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Padding="20"
                    Background="White"
                    BorderBrush="#DDE8F6"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="3"
                                      Opacity="0.07"
                                      Color="#31598F"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ActionHeadingText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Capture controls"/>
                        <TextBlock x:Name="ActionDescriptionText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Create a new floating image or close the current pins."/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,16,-10,-10">
                        <Button x:Name="CaptureButton"
                                Style="{StaticResource ScreenPinPrimaryButton}"
                                Click="OnCapture"
                                AutomationProperties.Name="Capture region">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="15"
                                           Text="&#xE722;"/>
                                <TextBlock x:Name="CaptureButtonText" Text="Capture Region"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseAllButton"
                                Style="{StaticResource ScreenPinButton}"
                                Click="OnCloseAll"
                                AutomationProperties.Name="Close all pins">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="15"
                                           Text="&#xE74D;"/>
                                <TextBlock x:Name="CloseAllButtonText" Text="Close All Pins"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="14,12"
                    Background="#EAF3FF"
                    BorderBrush="#D2E3FC"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" Background="#D9E9FF">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="&#xE91B;"/>
                    </Border>
                    <TextBlock x:Name="CountText"
                               Grid.Column="1"
                               Margin="11,0,10,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#35577F"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Border Grid.Column="2"
                            MinWidth="30"
                            Height="26"
                            Padding="9,0"
                            Background="White"
                            BorderBrush="#C9DDF8"
                            BorderThickness="1"
                            CornerRadius="13">
                        <TextBlock x:Name="CountBadgeText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="0"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
