<Window x:Class="QingToolbox.Modules.ScreenPin.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="120" MinHeight="80"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <CubicEase x:Key="OverlayEase" EasingMode="EaseInOut"/>

        <Style x:Key="OverlayIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#7A0F172A"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D92563EB"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#99BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D91E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource OverlayIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D9DC2626"/>
                    <Setter Property="BorderBrush" Value="#99FECACA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ImageHost"
          Background="Transparent"
          MouseEnter="OnHostMouseEnter"
          MouseLeave="OnHostMouseLeave"
          MouseLeftButtonDown="OnImageHostMouseLeftButtonDown">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="TopmostMenuItem"
                          Header="Unpin"
                          Click="OnToggleTopmost"/>
                <MenuItem x:Name="ResizeModeMenuItem"
                          Header="Free stretch"
                          Click="OnToggleResizeMode"/>
                <MenuItem x:Name="CopyMenuItem"
                          Header="Copy"
                          Click="OnCopy"/>
                <Separator/>
                <MenuItem x:Name="CloseMenuItem"
                          Header="Close"
                          Click="OnClose"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Image x:Name="PinnedImage"
               Stretch="Fill"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <Grid x:Name="OverlayControls"
              Margin="8"
              Opacity="0"
              IsHitTestVisible="False">
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="3"
                    Background="#8F0F172A"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TopmostButton"
                            Margin="0,0,3,0"
                            Style="{StaticResource OverlayIconButtonStyle}"
                            ToolTip="Unpin"
                            Click="OnToggleTopmost">
                        <TextBlock x:Name="TopmostIcon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Text="&#xE840;"/>
                    </Button>
                    <Button x:Name="ResizeModeButton"
                            Margin="0,0,3,0"
                            Style="{StaticResource OverlayIconButtonStyle}"
                            ToolTip="Aspect ratio resize"
                            Click="OnToggleResizeMode">
                        <TextBlock x:Name="ResizeModeIcon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Text="&#xE8B9;"/>
                    </Button>
                    <Button x:Name="CopyButton"
                            Style="{StaticResource OverlayIconButtonStyle}"
                            ToolTip="Copy"
                            Click="OnCopy">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Text="&#xE8C8;"/>
                    </Button>
                </StackPanel>
            </Border>

            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0"
                    Style="{StaticResource OverlayCloseButtonStyle}"
                    ToolTip="Close"
                    Click="OnClose">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="14"
                           Text="&#xE8BB;"/>
            </Button>
        </Grid>

        <Thumb x:Name="CornerResizeGrip"
               Width="18"
               Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,1,1"
               Cursor="SizeNWSE"
               Opacity="0.52"
               DragStarted="OnResizeGripDragStarted"
               DragDelta="OnResizeGripDragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Stroke="#CCFFFFFF"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 6 15 L 15 6 M 11 16 L 16 11"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
