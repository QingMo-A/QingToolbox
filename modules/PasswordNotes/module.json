{
  "id": "qing.passwordnotes",
  "name": "密码记事本",
  "description": "分类整理游戏和网站的多组账号密码，支持备注、分别复制、密码显隐及 TXT 导出。\n数据使用当前 Windows 用户的 DPAPI 加密保存；TXT 导出为明文，不是跨设备加密备份。",
  "version": "0.1.0",
  "apiVersion": 1,
  "author": "QingMo-A",
  "minimumHostVersion": "0.3.4-alpha",
  "entry": "bin/qing-passwordnotes-module.exe",
  "runtimeType": "Process",
  "runtimeIsolation": "OutOfProcess",
  "uiKind": "Web",
  "webEntry": "ui/index.html",
  "loadMode": "Manual",
  "permissions": ["FileRead", "FileWrite", "Clipboard"],
  "hostCapabilities": ["fileDialog.saveFile", "dialog.show", "notification.show"],
  "icon": "icon.svg",
  "defaultLanguage": "zh-CN",
  "localization": { "basePath": "i18n", "resources": { "zh-CN": "i18n/zh-CN.json", "en-US": "i18n/en-US.json" } },
  "operations": ["getState", "saveCategory", "deleteCategory", "saveEntry", "deleteEntry", "getEntryForEdit", "getPassword", "copyCredential", "copyLink", "exportTxt"]
}
