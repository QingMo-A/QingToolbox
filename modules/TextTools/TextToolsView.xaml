<UserControl x:Class="QingToolbox.Modules.TextTools.TextToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420" MinHeight="480" Background="#F4F8FE">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#23446F"/><Setter Property="BorderBrush" Value="#D6E2F3"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#D9E7FA"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="20" CornerRadius="18" BorderBrush="#D9E7FA" BorderThickness="1">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF"/><GradientStop Color="#EAF3FF" Offset="1"/></LinearGradientBrush></Border.Background>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" Foreground="#10264A"/>
                <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="InputLabelText" Margin="2,0,0,7" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="InputTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextChanged="InputTextChanged"
                         AutomationProperties.Name="Input text"/>
            </Grid>
            <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="OutputLabelText" Margin="2,0,0,7" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="OutputTextBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextChanged="OutputTextChanged"
                         AutomationProperties.Name="Output text"/>
            </Grid>
        </Grid>
        <WrapPanel Grid.Row="2">
            <Button x:Name="FormatJsonButton" Style="{StaticResource PrimaryButton}" Click="FormatJson_Click"/>
            <Button x:Name="MinifyJsonButton" Style="{StaticResource ActionButton}" Click="MinifyJson_Click"/>
            <Button x:Name="Base64EncodeButton" Style="{StaticResource ActionButton}" Click="Base64Encode_Click"/>
            <Button x:Name="Base64DecodeButton" Style="{StaticResource ActionButton}" Click="Base64Decode_Click"/>
            <Button x:Name="UrlEncodeButton" Style="{StaticResource ActionButton}" Click="UrlEncode_Click"/>
            <Button x:Name="UrlDecodeButton" Style="{StaticResource ActionButton}" Click="UrlDecode_Click"/>
            <Button x:Name="UppercaseButton" Style="{StaticResource ActionButton}" Click="Uppercase_Click"/>
            <Button x:Name="LowercaseButton" Style="{StaticResource ActionButton}" Click="Lowercase_Click"/>
            <Button x:Name="RemoveEmptyLinesButton" Style="{StaticResource ActionButton}" Click="RemoveEmptyLines_Click"/>
            <Button x:Name="CopyOutputButton" Style="{StaticResource ActionButton}" Click="CopyOutput_Click"/>
            <Button x:Name="CopyOutputToInputButton" Style="{StaticResource ActionButton}" Click="CopyOutputToInput_Click"/>
            <Button x:Name="SwapButton" Style="{StaticResource ActionButton}" Click="Swap_Click"/>
            <Button x:Name="ClearButton" Style="{StaticResource ActionButton}" Click="Clear_Click"/>
        </WrapPanel>
        <Border Grid.Row="3" Margin="0,6,0,0" Padding="13,10" Background="#EAF3FF" BorderBrush="#D2E3FC" BorderThickness="1" CornerRadius="11">
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" Foreground="#475569" AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</UserControl>
