<UserControl x:Class="QingToolbox.Modules.QingTransfer.QingTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520" MinHeight="420" Background="#F4F8FE">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#23446F"/><Setter Property="BorderBrush" Value="#D6E2F3"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EDF4FF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCEAFF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#F7FAFF"/>
            <Setter Property="Foreground" Value="#60738F"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="20" CornerRadius="18" BorderBrush="#D9E7FA" BorderThickness="1">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF"/><GradientStop Color="#EAF3FF" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="50" Height="50" CornerRadius="15" Background="#2563EB"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" Text="&#xE8CE;" FontFamily="Segoe Fluent Icons"/></Border>
                <StackPanel Grid.Column="1" Margin="15,1,0,0"><TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" Foreground="#10264A"/><TextBlock x:Name="SubtitleText" Margin="0,5,0,0" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,15,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource ActionButton}" Click="OnRefresh"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE72C;"/><TextBlock x:Name="RefreshButtonText"/></StackPanel></Button>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#D9E7FA" BorderThickness="1" CornerRadius="12" Padding="1">
            <Grid><ListView x:Name="PeersList" BorderThickness="0" Background="Transparent"><ListView.View><GridView>
                <GridViewColumn x:Name="DeviceColumn" Width="180" DisplayMemberBinding="{Binding DisplayName}"/>
                <GridViewColumn x:Name="PlatformColumn" Width="105" DisplayMemberBinding="{Binding Platform}"/>
                <GridViewColumn x:Name="StatusColumn" Width="85" DisplayMemberBinding="{Binding OnlineText}"/>
                <GridViewColumn x:Name="EndpointColumn" Width="170" DisplayMemberBinding="{Binding Endpoint}"/>
            </GridView></ListView.View></ListView>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#334155" Text="&#xE8CE;" FontFamily="Segoe Fluent Icons"/><TextBlock x:Name="EmptyText" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#475569" TextWrapping="Wrap"/><TextBlock x:Name="HintText" Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,9" Background="#EAF3FF" BorderBrush="#D2E3FC" BorderThickness="1" CornerRadius="10"><TextBlock x:Name="FooterText" Foreground="#475569" TextWrapping="Wrap"/></Border>
    </Grid>
</UserControl>
