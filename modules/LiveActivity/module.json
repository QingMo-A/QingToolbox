{
  "id": "qing.liveactivity",
  "name": "Qing Island",
  "description": "可自定义的桌面灵动岛：时间、计时/倒计时与 Codex 数据占位符。\n支持轻量 Markdown、行内图标和 {space} 左右排版，字体跟随工具箱。\n可调整位置和大小；提供实色、半透明、GPU 磨砂、液态玻璃与果冻材质。\nCodex 额度可自动读取；任务状态需接入共享服务，不等同于剩余 Token 数。\n玻璃实现借鉴（MIT）：[electron-liquid-glass](https://github.com/hicccc77/electron-liquid-glass) · [liquidDX11](https://github.com/poncippg-spec/liquidDX11)。",
  "version": "0.1.16",
  "apiVersion": 1,
  "author": "QingMo-A",
  "minimumHostVersion": "0.3.4-alpha",
  "entry": "bin/qing-liveactivity-module.exe",
  "runtimeType": "Process",
  "runtimeIsolation": "OutOfProcess",
  "uiKind": "Web",
  "webEntry": "ui/index.html",
  "loadMode": "Startup",
  "permissions": [
    "ProcessStart",
    "WindowControl"
  ],
  "icon": "icon.svg",
  "defaultLanguage": "zh-CN",
  "localization": {
    "basePath": "i18n",
    "resources": {
      "en-US": "i18n/en-US.json",
      "zh-CN": "i18n/zh-CN.json"
    }
  },
  "operations": [
    "getState",
    "setSettings",
    "previewSettings",
    "previewIsland",
    "dismissPreview",
    "emitMockActivity",
    "clearActivities",
    "readDiagnostics",
    "clearDiagnostics",
    "setCodexEnabled",
    "refreshProviders",
    "timerCommand",
    "hideTemporarily",
    "restoreIsland",
    "openGlassReference"
  ]
}
