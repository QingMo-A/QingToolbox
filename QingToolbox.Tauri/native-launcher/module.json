{
  "id": "qing.launcher",
  "name": "Qing Launcher",
  "description": "Rust-powered application launchpad for QingToolbox.",
  "version": "0.1.0",
  "author": "QingMo-A",
  "entry": "bin/qing-launcher-module.exe",
  "runtimeType": "Process",
  "runtimeIsolation": "OutOfProcess",
  "uiKind": "Web",
  "webEntry": "ui/index.html",
  "loadMode": "Manual",
  "permissions": ["FileRead", "FileWrite", "ProcessStart", "WindowControl"],
  "operations": [
    "getState",
    "refreshDesktop",
    "setSortMode",
    "setCustomOrder",
    "setHotkey",
    "launchItem",
    "removeItem",
    "createFolder",
    "renameFolder",
    "moveItemToFolder",
    "moveItemOutOfFolder",
    "setFolderOrder",
    "deleteFolder",
    "searchEverything",
    "openEverythingResult",
    "openEverythingResultFolder",
    "copyEverythingResultPath"
  ],
  "events": [
    "launcher.externalDrop"
  ],
  "icon": "icon.svg"
}
