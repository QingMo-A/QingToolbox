{
  "id": "qing.powerguard",
  "name": "PowerGuard",
  "description": "Monitor connectivity and safely shut down after a confirmed outage.",
  "version": "0.2.0",
  "author": "QingMo-A",
  "minimumHostVersion": "0.1.0",
  "entry": "bin/qing-powerguard-module.exe",
  "runtimeType": "Process",
  "runtimeIsolation": "OutOfProcess",
  "uiKind": "Web",
  "webEntry": "ui/index.html",
  "loadMode": "Manual",
  "permissions": ["Network", "ProcessStart", "WindowControl"],
  "icon": "icon.svg",
  "defaultLanguage": "zh-CN",
  "localization": {
    "basePath": "i18n",
    "resources": {
      "en-US": "i18n/en-US.json",
      "zh-CN": "i18n/zh-CN.json"
    }
  },
  "operations": [
    "getState",
    "setSettings",
    "probeNow",
    "testWarning",
    "cancelCurrent",
    "rearmCurrent",
    "extendCountdown",
    "shutdownNow",
    "readEvents",
    "clearEvents"
  ]
}
