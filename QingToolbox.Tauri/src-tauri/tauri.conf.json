{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QingToolbox",
  "version": "0.1.0",
  "identifier": "com.qingmo.qingtoolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../QingToolbox.WebUI/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QingToolbox",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' qfont: data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": ["resources/modules"]
  }
}
