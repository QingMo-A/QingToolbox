# Preserve the upstream Everything license byte-for-byte. Its historical
# tab-indented lines intentionally contain trailing spaces; those are not
# project-authored source whitespace and must not trigger diff checks.
QingToolbox.Tauri/native-launcher/third-party/Everything/LICENSE.txt -text -diff whitespace=-trailing-space
QingToolbox.Tauri/native-launcher/third-party/Everything/NOTICE.md -text -diff

# Preserve qpdf's upstream notice/license bytes when checking out on Windows.
QingToolbox.Tauri/native-pdf/third-party/qpdf/LICENSE.txt -text -diff
QingToolbox.Tauri/native-pdf/third-party/qpdf/NOTICE.md -text -diff
QingToolbox.Tauri/native-pdf/third-party/qpdf/SHA256SUMS -text -diff
